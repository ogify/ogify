{
  "name": "@ogify/core",
  "version": "0.1.1",
  "description": "Core types and utilities for OGify Open Graph image generator",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "open-graph",
    "og-image",
    "typescript",
    "satori",
    "react"
  ],
  "author": "OGify Team",
  "license": "MIT",
  "dependencies": {
    "satori": "^0.10.14",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
