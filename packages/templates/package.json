{
  "name": "@ogify/templates",
  "version": "1.0.1",
  "description": "Pre-designed templates for OGify",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./basic": {
      "types": "./dist/basic/index.d.ts",
      "import": "./dist/basic/index.mjs",
      "require": "./dist/basic/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "echo 'No tests available'",
    "test:watch": "echo 'No tests available'",
    "test:ui": "echo 'No tests available'",
    "test:coverage": "echo 'No tests available'",
    "release": "release-it"
  },
  "author": {
    "name": "Hung Pham - @revolabs-io",
    "email": "info@revolabs.io"
  },
  "license": "MIT",
  "peerDependencies": {
    "@ogify/core": "*"
  },
  "devDependencies": {
    "@ogify/core": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
