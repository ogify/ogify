{
  "name": "ogify",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:ui": "turbo run test:ui",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "examples": "turbo run dev --filter=@ogify/examples",
    "release:core": "cd packages/core && pnpm run release",
    "release:templates": "cd packages/templates && pnpm run release",
    "release": "pnpm run release:core && pnpm run release:templates"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "eslint": "9.39.1",
    "prettier": "3.7.4",
    "release-it": "^19.2.2",
    "turbo": "^2.6.3",
    "typescript": "5.9.3"
  }
}
